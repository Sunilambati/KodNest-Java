import java.util.Scanner;

class SalesAnalyzer {
    double[] dailySales;
    
    SalesAnalyzer(double[] dailySales) {
        this.dailySales = dailySales;
    }
    
    double calculateTotal() {
        double total = 0.0;
        
    for (int i = 0; i < dailySales.length-1; i++) {
        total =  total + dailySales[i];
    }
    return total;
    
    }
    
    double calculateAverage() {
        double total = calculateTotal();
        double average = total/dailySales.length;
        return average;
    }
    int findHighestSalesDay() {
        int highestIndex = 0;
        for(int i = 1; i < dailySales.length;i++) {
            if(dailySales[i] > dailySales[highestIndex]) {
                highestIndex = i;
            }
        }
        return highestIndex + 1;
    }
    
    int findLowestSalesDay() {
        int lowestSales = 0;
        for(int i = 1; i < dailySales.length; i++) {
            if(dailySales[i] < dailySales[lowestSales]) {
                lowestSales = i;
            }
        }
        return lowestSales + 1;
    }
    
    int countAboveAverageDays() {
        int count = 0;
        double average = calculateAverage();
        for (int i = 0; i < dailySales.length; i++) {
            if(dailySales[i] > average) {
                count++;
            }
        }
        return count;
    }
    
    void displayReport() {
        int highestIndex = findHighestSalesDay();
        int lowestIndex = findLowestSalesDay();
        System.out.println("Number of days: " + dailySales.length);
        System.out.println("Total sales: " + calculateTotal());
        System.out.println("Average sales: " + calculateAverage());
        System.out.println("Highest sales day: " + highestIndex);
        System.out.println("Highest sales value: " + dailySales[highestIndex-1]);
        System.out.println("Lowest sales day: " + lowestIndex);
        System.out.println("Lowest sales value: " + dailySales[lowestIndex-1]);
        System.out.println("Number of days above average: " + countAboveAverageDays());
        
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        int numberOfDays = scanner.nextInt();
        
        double[] dailySales = new double[numberOfDays];
        for (int i = 0; i < dailySales.length; i++) {
            dailySales[i] = scanner.nextDouble();
        }
        SalesAnalyzer analyzer = new SalesAnalyzer(dailySales);
        
        analyzer.displayReport();
        
    }
}